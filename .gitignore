# ==========================================
# Chama's Academy - Unified .gitignore
# ==========================================

# ------------------------------------------
# Java & Maven (Backend)
# ------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/.maven-wrapper-cache/

# ------------------------------------------
# Node.js, React & Vite (Frontend)
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
coverage/
frontend/coverage/
*.tsbuildinfo
next-env.d.ts
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env
!.env.example
*.pem
*.key

# ------------------------------------------
# IDEs & Editor Configurations
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Operating System Artifacts
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
