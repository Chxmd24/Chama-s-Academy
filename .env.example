# ==========================================
# Chama's Academy - Environment Variables Template
# ==========================================
# Copy this file to .env or .env.local and populate with your credentials.
# Do NOT commit active .env files to version control.

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# MySQL 8.0 Database Configuration (for 'mysql' profile)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/chamas_academy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security Configuration (Future Auth Milestone)
JWT_SECRET=your_base64_or_hex_encoded_256_bit_secret_key_placeholder
JWT_EXPIRATION_HOURS=24

# Frontend Configuration
VITE_API_BASE_URL=/api
